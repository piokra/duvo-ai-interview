{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {"id": 1, "type": "stat", "title": "Jobs accepted (24h)", "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}, "targets": [{"expr": "sum(increase(jobs_produced_total[24h]))", "legendFormat": "jobs"}], "fieldConfig": {"defaults": {"decimals": 0}}},
    {"id": 2, "type": "stat", "title": "Queue backlog", "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0}, "targets": [{"expr": "sum(redis_stream_group_lag{group=\"rollout-consumers\"}) + sum(redis_stream_group_messages_pending{group=\"rollout-consumers\"})", "legendFormat": "queued + pending"}], "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 20}]}}}},
    {"id": 3, "type": "stat", "title": "Successful jobs (24h)", "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0}, "targets": [{"expr": "sum(increase(jobs_processed_total{result=\"success\"}[24h]))", "legendFormat": "success"}], "fieldConfig": {"defaults": {"decimals": 0}}},
    {"id": 4, "type": "stat", "title": "Failed jobs (24h)", "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0}, "targets": [{"expr": "sum(increase(jobs_processed_total{result=\"error\"}[24h]))", "legendFormat": "errors"}], "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}},
    {"id": 5, "type": "stat", "title": "Ready sandboxes", "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0}, "targets": [{"expr": "sum(kube_pod_status_ready{namespace=\"sandboxes\",condition=\"true\"})", "legendFormat": "ready"}], "fieldConfig": {"defaults": {"decimals": 0}}},
    {"id": 6, "type": "stat", "title": "Firing alerts", "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0}, "targets": [{"expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)", "legendFormat": "alerts"}], "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}},
    {"id": 7, "type": "timeseries", "title": "Job flow", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "targets": [{"expr": "sum(rate(jobs_produced_total[5m]))", "legendFormat": "produced/s"}, {"expr": "sum by (result) (rate(jobs_processed_total[5m]))", "legendFormat": "processed {{result}}/s"}], "fieldConfig": {"defaults": {"unit": "ops"}}},
    {"id": 8, "type": "timeseries", "title": "Sandbox startup latency", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(sandbox_startup_duration_seconds_bucket[10m])))", "legendFormat": "p50"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(sandbox_startup_duration_seconds_bucket[10m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 9, "type": "timeseries", "title": "Sandbox pod phases", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "targets": [{"expr": "sum by (phase) (kube_pod_status_phase{namespace=\"sandboxes\"} == 1)", "legendFormat": "{{phase}}"}], "fieldConfig": {"defaults": {"decimals": 0}}},
    {"id": 10, "type": "timeseries", "title": "Scrape target health", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "targets": [{"expr": "up", "legendFormat": "{{job}}"}], "fieldConfig": {"defaults": {"min": 0, "max": 1, "decimals": 0}}},
    {"id": 11, "type": "gauge", "title": "Node memory used", "gridPos": {"h": 7, "w": 8, "x": 0, "y": 20}, "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "memory"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 75}, {"color": "red", "value": 90}]}}}},
    {"id": 12, "type": "gauge", "title": "Root disk used", "gridPos": {"h": 7, "w": 8, "x": 8, "y": 20}, "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"})", "legendFormat": "disk"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 75}, {"color": "red", "value": 90}]}}}},
    {"id": 13, "type": "stat", "title": "Pod restarts (1h)", "gridPos": {"h": 7, "w": 8, "x": 16, "y": 20}, "targets": [{"expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"platform|sandboxes|observability\"}[1h]))", "legendFormat": "restarts"}], "fieldConfig": {"defaults": {"decimals": 0}}},
    {"id": 14, "type": "timeseries", "title": "Jobs produced by workload / version (5m count)", "description": "Every line is a manifest version. During rollout this makes the stable/canary traffic split visible.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 27}, "targets": [{"expr": "sum by (workload, workload_version) (increase(jobs_produced_total[5m]))", "legendFormat": "{{workload}} @ {{workload_version}}"}], "fieldConfig": {"defaults": {"decimals": 0, "min": 0}}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}}},
    {"id": 15, "type": "timeseries", "title": "Job outcomes by workload / version", "description": "Completed jobs per second, split by manifest version and result. Canary failures should appear on the 2.0.0 error series before rollback.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 27}, "targets": [{"expr": "sum by (workload, workload_version, result) (rate(jobs_processed_total[2m]))", "legendFormat": "{{workload}} @ {{workload_version}} — {{result}}"}], "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}}},
    {"id": 16, "type": "timeseries", "title": "Batch processing latency by version", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 35}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, workload, workload_version) (rate(job_processing_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{workload}} @ {{workload_version}}"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 17, "type": "timeseries", "title": "Kubernetes Jobs by version / result", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 35}, "targets": [{"expr": "sum by (label_workload, label_workload_version) (kube_job_status_succeeded{namespace=\"sandboxes\"})", "legendFormat": "{{label_workload}} @ {{label_workload_version}} — succeeded"}, {"expr": "sum by (label_workload, label_workload_version) (kube_job_status_failed{namespace=\"sandboxes\"})", "legendFormat": "{{label_workload}} @ {{label_workload_version}} — failed"}], "fieldConfig": {"defaults": {"decimals": 0, "min": 0}}},
    {"id": 18, "type": "timeseries", "title": "Progressive rollout — canary traffic %", "description": "Expected steps are 10% → 25% → 50% → 100%. A drop to 0% is an automated rollback.", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 43}, "targets": [{"expr": "rollout_canary_weight_percent", "legendFormat": "{{workload}} @ {{version}}"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"lineInterpolation": "stepAfter", "fillOpacity": 20}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}}},
    {"id": 19, "type": "timeseries", "title": "Canary error ratio (rollback above 5%)", "description": "Observed error ratio for the canary version. The red threshold is the controller's rollback gate.", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 43}, "targets": [{"expr": "rollout_error_ratio", "legendFormat": "{{workload}} @ {{version}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}, "custom": {"thresholdsStyle": {"mode": "line+area"}}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}}},
    {"id": 20, "type": "state-timeline", "title": "Rollout state (progressing / promoted / rolled_back)", "description": "The active state is emitted as a labelled one-hot metric; rolled_back remains visible after traffic returns to 0%.", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 43}, "targets": [{"expr": "rollout_state == 1", "legendFormat": "{{workload}} @ {{version}} — {{state}}"}], "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"1": {"text": "ACTIVE", "color": "green"}}}]}}},
    {"id": 21, "type": "stat", "title": "Canary samples evaluated", "description": "Number of canary completions used by the automated rollout decision.", "gridPos": {"h": 4, "w": 8, "x": 16, "y": 51}, "targets": [{"expr": "rollout_evaluated_samples", "legendFormat": "{{workload}} @ {{version}}"}], "fieldConfig": {"defaults": {"decimals": 0, "min": 0}}}
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["duvo", "sre"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Duvo Sandbox Platform Overview",
  "uid": "duvo-overview",
  "version": 3
}
